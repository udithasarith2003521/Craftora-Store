# Database (Neon Serverless Postgres via Vercel Marketplace or Neon.tech)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob Storage Token (from Vercel Blob store)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# Single-Admin Authentication
ADMIN_USERNAME="admin"
# Generate with: node scripts/hash-password.mjs "YourSecurePassword"
ADMIN_PASSWORD_HASH="$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Secure random string for signing JWT tokens (at least 32 characters)
JWT_SECRET="craftora-super-secret-jwt-key-min-32-chars-futuristic"

# Secret unguessable URL path for the admin area (DO NOT use 'admin' or 'login')
# Example: craftora-hq-7f3k9x
ADMIN_SECRET_PATH="craftora-hq-7f3k9x"

# Public Site URL (for SEO, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
